<odoo>

    <!-- user: sees the e-invoicing state, validates and sends invoices -->
    <record id="group_mirak_ae_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Validate and send e-invoices, follow their status.</field>
    </record>

    <!-- manager: settings and the connection to the service provider (API key) -->
    <record id="group_mirak_ae_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_mirak_ae_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Settings, service provider and API key.</field>
    </record>

    <!-- multi-company -->
    <record id="rule_mirak_ae_provider_company" model="ir.rule">
        <field name="name">E-invoicing provider: own companies</field>
        <field name="model_id" ref="model_mirak_ae_provider"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_mirak_ae_log_company" model="ir.rule">
        <field name="name">E-invoicing log: own companies</field>
        <field name="model_id" ref="model_mirak_ae_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
