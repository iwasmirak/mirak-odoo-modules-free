<odoo>
    <record id="privilege_mirak_ae" model="res.groups.privilege">
        <field name="name">UAE E-Invoicing</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">60</field>
    </record>

    <!-- user: sees the e-invoicing state, validates and sends invoices -->
    <record id="group_mirak_ae_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_mirak_ae"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Validate and send e-invoices, follow their status.</field>
    </record>

    <!-- manager: settings and the connection to the service provider (API key) -->
    <record id="group_mirak_ae_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_mirak_ae"/>
        <field name="implied_ids" eval="[(4, ref('group_mirak_ae_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Settings, service provider and API key.</field>
    </record>

    <!-- multi-company -->
</odoo>
