<odoo>
    <record id="product_template_form_view_snoonu" model="ir.ui.view">
        <field name="name">product.template.form.snoonu</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_snoonu" type="object" class="oe_stat_button" icon="fa-motorcycle"
                        groups="mirak_snoonu_connector_trial.group_snoonu_user" invisible="not snoonu_count">
                    <field name="snoonu_count" widget="statinfo" string="Snoonu"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
