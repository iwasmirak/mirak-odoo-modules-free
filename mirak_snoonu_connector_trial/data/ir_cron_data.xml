<odoo noupdate="1">
    <record id="ir_cron_snoonu_sync" model="ir.cron">
        <field name="name">Snoonu: Send Price and Stock Changes</field>
        <field name="model_id" ref="model_snoonu_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <!-- Checks every 5 minutes; each account runs according to its own interval.
             Switched on automatically when an account enables Automatic Sync. -->
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
