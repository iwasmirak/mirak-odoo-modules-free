<odoo>
    <record id="snoonu_add_products_view_form" model="ir.ui.view">
        <field name="name">snoonu.add.products.form</field>
        <field name="model">snoonu.add.products</field>
        <field name="arch" type="xml">
            <form string="Add Products to Snoonu">
                <group>
                    <group>
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="selection" widget="radio"/>
                    </group>
                    <group>
                        <field name="sku_source" widget="radio"/>
                        <field name="visible"/>
                        <field name="send_now"/>
                    </group>
                </group>
                <field name="product_ids" invisible="selection != 'selected'" widget="many2many_tags"
                       placeholder="Choose products..."/>
                <field name="categ_ids" invisible="selection != 'category'" widget="many2many_tags"
                       placeholder="Choose categories..."/>
                <div class="text-muted small mt-2">
                    Products without SKU, or whose SKU is already used on this account, are skipped and listed.
                </div>
                <footer>
                    <button name="action_add" type="object" string="Add" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="snoonu_add_products_action" model="ir.actions.act_window">
        <field name="name">Add to Snoonu</field>
        <field name="res_model">snoonu.add.products</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('mirak_snoonu_connector_trial.group_snoonu_user'))]"/>
    </record>

    <record id="snoonu_add_variants_action" model="ir.actions.act_window">
        <field name="name">Add to Snoonu</field>
        <field name="res_model">snoonu.add.products</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('mirak_snoonu_connector_trial.group_snoonu_user'))]"/>
    </record>

    <record id="snoonu_payload_preview_view_form" model="ir.ui.view">
        <field name="name">snoonu.payload.preview.form</field>
        <field name="model">snoonu.payload.preview</field>
        <field name="arch" type="xml">
            <form string="Payload Preview">
                <group>
                    <field name="endpoint_url" widget="CopyClipboardChar"/>
                    <field name="product_count" string="Products on the account"/>
                </group>
                <div class="text-muted small">PATCH request, first 20 products. Nothing is sent from this window.</div>
                <field name="payload" widget="code" options="{'mode': 'json'}"/>
                <footer>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
